    "./decoders/node": "./src/decoders/node.js"
  },
  "files": [
    "src",
    "hosts",
    "tools/build-plugin.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-plugin.mjs",
    "test": "node tools/run-tests.mjs",
    "demo": "node demo.mjs"
  },
  "keywords": [
    "long-image",
    "screenshot",
    "vision",
    "llm",
    "multimodal",
    "image-split",
    "qq-agent",
    "plugin"
